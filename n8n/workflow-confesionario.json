        "sendTo": "={{ $('Recibir email').item.json.body.email }}",
        "subject": "Tu penitencia ambiental — CarbonBox",
        "emailType": "html",
        "message": "={{ '<div style=\"background:#F3F4FA;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;\">' + '<div style=\"max-width:480px;margin:0 auto;background:#FFFFFF;border-radius:14px;overflow:hidden;border:1px solid #E3E5F0;\">' + '<div style=\"background:#1620A4;padding:18px 24px;\">' + '<p style=\"margin:0;color:#FFFFFF;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;\">CarbonBox &middot; Confesionario Ambiental</p>' + '</div>' + '<div style=\"padding:28px 24px;\">' + '<p style=\"margin:0 0 16px;color:#333A4D;font-size:15px;line-height:1.5;\">Hola,</p>' + '<p style=\"margin:0 0 20px;color:#333A4D;font-size:15px;line-height:1.5;\">Aquí está tu confesión y la penitencia que te asignó el Padre Carbono:</p>' + '<div style=\"background:#F3F4FA;border-radius:10px;padding:18px 20px;margin:0 0 22px;\">' + '<p style=\"margin:0 0 4px;color:#7A82A0;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;\">Pecado confesado</p>' + '<p style=\"margin:0 0 16px;color:#333A4D;font-size:14px;font-style:italic;\">\"' + $json.pecado + '\"</p>' + '<p style=\"margin:0 0 4px;color:#7A82A0;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;\">Tu penitencia</p>' + '<p style=\"margin:0;color:#1620A4;font-size:15px;font-weight:700;\">' + $json.penitencia + '</p>' + '</div>' + '<div style=\"text-align:center;margin:0 0 8px;\">' + '<a href=\"https://TU-N8N.app.n8n.cloud/webhook/confesion-card?id=' + $json.confessionId + '\" style=\"display:inline-block;background:#2F6B4A;color:#FFFFFF;text-decoration:none;font-weight:700;font-size:13px;letter-spacing:.5px;text-transform:uppercase;padding:14px 28px;border-radius:999px;\">Ver y guardar tu tarjeta</a>' + '</div>' + '</div>' + '<div style=\"padding:16px 24px;border-top:1px solid #E3E5F0;text-align:center;\">' + '<p style=\"margin:0;color:#7A82A0;font-size:11px;\">Powered by <strong style=\"color:#2F6B4A;\">CarbonBox</strong></p>' + '</div>' + '</div>' + '</div>' }}",
