    {
      "id": "83d6c348-f946-411b-b7eb-429859d5bb3c",
      "name": "Armar página de tarjeta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function esc(s){\n  return String(s == null ? '' : s)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\nconst row = $input.first().json || {};\nconst found = !!row.confessionId;\n\nconst CAT_ICON = { movilidad:'✈️', energia:'💡', consumo:'🛍️', alimentacion:'🍔', residuos:'🗑️', agua:'🚿', otro:'🌍' };\nconst categoria = row.categoria || 'otro';\nconst icon = CAT_ICON[categoria] || '🌍';\n\nconst notFoundHtml = '<!doctype html><html lang=\"es\"><head><meta charset=\"UTF-8\"><title>No encontrada</title><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">' +\n  '<style>body{margin:0;min-height:100vh;background:#0D1054;color:#fff;font-family:Arial,sans-serif;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;}</style>' +\n  '</head><body><p>No encontramos esa confesión. Puede que el enlace haya expirado.</p></body></html>';\n\nconst foundHtml = '<!doctype html><html lang=\"es\"><head><meta charset=\"UTF-8\"><title>Tu penitencia — CarbonBox</title>' +\n  '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">' +\n  '<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">' +\n  '<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">' +\n  '<script src=\"https://cdnjs.cloudflare.com/ajax/libs/dom-to-image/2.6.0/dom-to-image.min.js\"><\\/script>' +\n  '<style>' +\n  ':root{--bg-0:#080A38;--bg-1:#0D1054;--brand-green:#2F6B4A;--brand-glow:#4ADE80;--brand-gray:#7A82A0;--ink:#FFFFFF;--ink-dim:#C3C8E8;--paper:#F3F4FA;--paper-ink:#12154A;--paper-dim:#565C84;}' +\n  '*{box-sizing:border-box;}' +\n  'body{margin:0;min-height:100vh;background:linear-gradient(180deg,var(--bg-0),var(--bg-1) 60%);color:var(--ink);font-family:\"Poppins\",Arial,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:32px 16px;}' +\n  '.brand{font-weight:800;letter-spacing:.08em;color:var(--brand-glow);font-size:12px;text-transform:uppercase;text-align:center;}' +\n  '.ticket{width:100%;max-width:360px;background:var(--paper);color:var(--paper-ink);border-radius:14px;padding:24px 20px;box-shadow:0 20px 40px -15px rgba(0,0,0,.6);}' +\n  '.ticket-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px dashed var(--brand-gray);padding-bottom:8px;margin-bottom:12px;font-weight:700;font-size:12px;}' +\n  '.cat-pill{font-size:10px;font-weight:600;text-transform:uppercase;background:var(--brand-green);color:#fff;padding:3px 8px;border-radius:999px;}' +\n  '.label{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-dim);margin:0 0 4px;}' +\n  '.sin{font-size:13px;margin:0 0 14px;}' +\n  '.pen{font-size:15px;font-weight:600;color:#1620A4;margin:0 0 14px;}' +\n  '.msg{font-style:italic;font-size:13px;color:var(--paper-dim);text-align:center;margin-top:14px;}' +\n  '.btn{font-family:\"Poppins\",sans-serif;font-weight:700;font-size:13px;letter-spacing:.05em;text-transform:uppercase;color:#08240F;background:var(--brand-glow);border:none;border-radius:999px;padding:14px 28px;cursor:pointer;}' +\n  '.hint{font-size:12px;color:var(--ink-dim);text-align:center;max-width:300px;}' +\n  '</style></head><body>' +\n  '<p class=\"brand\">CarbonBox · Confesionario Ambiental</p>' +\n  '<div class=\"ticket\" id=\"ticket\">' +\n    '<div class=\"ticket-head\"><span>ABSOLUCIÓN N.º ' + esc(String(row.confessionId).slice(-4)) + '</span><span class=\"cat-pill\">' + icon + ' ' + esc(categoria) + '</span></div>' +\n    '<p class=\"label\">Pecado confesado</p><p class=\"sin\">\"' + esc(row.pecado) + '\"</p>' +\n    '<p class=\"label\">Tu penitencia</p><p class=\"pen\">' + esc(row.penitencia) + '</p>' +\n    '<p class=\"msg\">' + esc(row.mensaje) + '</p>' +\n  '</div>' +\n  '<button class=\"btn\" id=\"btnDownload\">Descargar imagen</button>' +\n  '<p class=\"hint\" id=\"dlHint\">Toca el botón para guardar tu penitencia como imagen en tu celular.</p>' +\n  '<script>document.getElementById(\"btnDownload\").addEventListener(\"click\", function(){ var node = document.getElementById(\"ticket\"); var hint = document.getElementById(\"dlHint\"); domtoimage.toPng(node, { bgcolor: \"#F3F4FA\", width: node.offsetWidth * 2, height: node.offsetHeight * 2, style: { transform: \"scale(2)\", transformOrigin: \"top left\" } }).then(function(dataUrl){ var link = document.createElement(\"a\"); link.download = \"penitencia-carbonbox.png\"; link.href = dataUrl; document.body.appendChild(link); link.click(); link.remove(); }).catch(function(err){ hint.textContent = \"No se pudo generar la imagen. Toma una captura de pantalla en su lugar.\"; }); });<\\/script>' +\n  '</body></html>';\n\nreturn [{ json: { html: found ? foundHtml : notFoundHtml } }];"
      }
    },
